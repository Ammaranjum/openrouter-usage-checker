<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Core.cs" Link="Core.cs" />
    <Compile Include="../../SettingsForm.cs" Link="SettingsForm.cs" />
    <Compile Include="../../AppTheme.cs" Link="AppTheme.cs" />
    <Compile Include="../../UsagePopup.cs" Link="UsagePopup.cs" />
    <EmbeddedResource Include="../../Assets/*.png" LogicalName="OpenRouterUsage.Assets.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
